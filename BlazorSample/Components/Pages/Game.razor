@page "/game"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable


<PageTitle>Jogo | BitText</PageTitle>

<section class="game-page">
    <div class="game-heading">
        <p class="eyebrow"><span class="status-dot"></span> ÁREA DE JOGO</p>
        <h1>Prepare-se para <span>jogar</span></h1>
        <p>A tela do jogo ficará disponível aqui em breve.</p>
    </div>

    <div class="game-screen" role="region" aria-label="Tela do jogo">
        <div class="screen-toolbar">
            <span>BITTEXT // GAME.EXE</span>
            @if (opcaoSelecionado == 1 || opcaoSelecionado == 2)
            {
                <button class="game-action game-action--exit" @onclick="() => selecionar(0)">EXIT</button>
            }
            else if (opcaoSelecionado == 3)
            {
                <button class="game-action game-action--save-exit" @onclick="() => selecionar(0)">Salvar e Sair</button>
            }
            else
            {
                <span class="screen-indicator"><span class="status-dot"></span> AGUARDANDO</span>
            }
        </div>
        <div class="screen-placeholder">
            @if (opcaoSelecionado == 0)
            {
                <div class="flex flex-col items-center gap-4">

                    <div class="flex gap-4">
                        <button type="button"
                                class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                                @onclick="() => selecionar(1)">
                            Tutorial
                        </button>
                        <button type="button"
                                class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                                @onclick="() => selecionar(2)">
                            Jogar
                        </button>
                    </div>
                    <button type="button"
                            class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                            @onclick="() => selecionar(3)">
                        Configurar
                    </button>
                </div>
            }
            //TUTORIAL
            else if (opcaoSelecionado == 1 || opcaoSelecionado == 2)
            {

                
                <div class="game-controls">
                    @if (opcaoSelecionado == 2)
                    {
                        <div
                            class="grid w-full grid-cols-3 items-baseline border-b border-[#00ff41]/30 pb-3 font-mono text-[#00ff41]">
                            <div class="flex items-baseline justify-start gap-2 drop-shadow-[0_0_6px_rgba(0,255,65,0.7)]">
                                <span class="text-base uppercase tracking-widest text-[#00ff41]">Tempo</span>
                                @if (tempoIlimitado)
                                {
                                    <span class="hud-infinity text-3xl font-bold leading-none text-[#00FF41]">∞</span>
                                }
                                else
                                {
                                    <span class="text-3xl font-bold leading-tight">@tempo</span>
                                }
                            </div>
                            <div class="flex items-baseline justify-center gap-2 drop-shadow-[0_0_6px_rgba(0,255,65,0.7)]">
                                <span class="text-base uppercase tracking-widest text-[#00ff41]">Pontos</span>
                                <span class="text-4xl font-bold leading-tight">@pontos</span>
                            </div>
                            <div class="flex items-baseline justify-end gap-2 drop-shadow-[0_0_6px_rgba(0,255,65,0.7)]">
                                <span class="text-lg uppercase tracking-widest text-[#00ff41]">Vidas</span>
                                <span class="text-3xl font-bold leading-tight">@vidas</span>
                            </div>
                        </div>
                    }
                    <div class="game-letter text-[clamp(8rem,30vw,18rem)] leading-none">@letra</div>
                    <input class="game-answer-input" type="text" id="resposta" name="resposta_jogo" @bind="respostaUsuario"
                           @onkeyup="VerificarEnter"
                           oninput="let v = this.value.replace(/[^01]/g, ''); this.value = v.length > 4 ? v.slice(0, 4) + '.' + v.slice(4, 8) : v;"
                           maxlength="9" autocomplete="off" spellcheck="false" />

                    <div class="game-input-buttons">
                        <button class="game-button game-button--digit" type="button" @onclick="addZero">0</button>
                        <button class="game-button game-button--digit" type="button" @onclick="addUm">1</button>
                        <button class="game-button game-button--remove" type="button" @onclick="remover">Remover</button>
                    </div>

                    <button class="game-submit" type="button" @onclick="EnviarResposta">Enviar</button>
                </div>

            }
            else if (opcaoSelecionado == 3)
            {
                <div class="flex flex-col gap-6 w-full max-w-xs mx-auto mt-8 font-mono text-[#00ff41]">
    
                    <!-- Título da aba -->
                    <h2 class="text-2xl text-center font-bold text-[#00ff41] drop-shadow-[0_0_8px_rgba(0,255,65,0.7)] mb-4">
                        CONFIGURAÇÕES
                    </h2>
                    <div class="time-setting">
                        <label for="tempo" class="time-setting__label">Tempo (em segundos)</label>
                        <input id="tempo" name="tempo" type="number" min="10" max="300" @bind="tempo"
                               disabled="@tempoIlimitado" class="time-setting__input" />
                        <label class="unlimited-toggle">
                            <input type="checkbox" @bind="tempoIlimitado" class="unlimited-toggle__input" />
                            <span class="unlimited-toggle__box" aria-hidden="true"></span>
                            <span class="unlimited-toggle__text">Ilimitado <span aria-hidden="true">∞</span></span>
                        </label>
                    </div>

                        <!-- Campo VIDAS -->
                        <div class="flex flex-col">
                            <label for="vidas" class="mb-2 text-sm uppercase tracking-widest text-[#00ff41]">Vidas
                                Iniciais</label>
                                <input id="vidas" name="vidas" type="number" min="1" max="10" @bind="vidas"
                                       class="bg-black border border-[#00ff41] text-[#00ff41] text-xl px-4 py-2 outline-none focus:border-[#00ff41] focus:shadow-[0_0_12px_rgba(0,255,65,0.7)] transition-all" />
                            </div>
                        </div>
                
                    }

                </div>
            </div>
        </section>

@code {
    private char letra = 'A';
    private int opcaoSelecionado = 0;
    private int pontos = 0;
    private bool tempoIlimitado = false;
    private int tempo = 60; // segundos 60 = 1min
    private int vidas = 3;
    private IJSObjectReference? gameModule;
    private bool scrollToGameControls;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToGameControls)
        {
            return;
        }

        scrollToGameControls = false;
        gameModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
        await gameModule.InvokeVoidAsync("scrollToGameControls");
    }

    public async ValueTask DisposeAsync()
    {
        if (gameModule is not null)
        {
            await gameModule.DisposeAsync();
        }
    }

    private string respostaUsuario = "";
    private void VerificarEnter(KeyboardEventArgs e)
    {
        // Se a tecla pressionada for o "Enter", dispara a lógica de envio
        if (e.Key == "Enter")
        {
            EnviarResposta();
        }
    }

    private void EnviarResposta()
    {
        // A sua lógica de verificação se o binário está certo entra aqui
        respostaUsuario = "";
    }


    private void selecionar(int opcao)
    {
        opcaoSelecionado = opcao;
        scrollToGameControls = opcao is 1 or 2;
    }
    private void remover()
    {
        if (string.IsNullOrEmpty(respostaUsuario)) return;
        string numerosApenas = respostaUsuario.Replace(".", "");

        numerosApenas = numerosApenas.Remove(numerosApenas.Length - 1, 1);
        if (numerosApenas.Length > 4)
        {
            respostaUsuario = numerosApenas.Substring(0, 4) + "." + numerosApenas.Substring(4);
        }
        else
        {
            respostaUsuario = numerosApenas;
        }
    }

    private void addZero() => AdicionarNumero('0');
    private void addUm() => AdicionarNumero('1');
    
    private void AdicionarNumero(char numero)
    {
        string numerosApenas = respostaUsuario.Replace(".", "");
        if (numerosApenas.Length >= 8) return;
        numerosApenas += numero;
        if (numerosApenas.Length > 4)
        {
            respostaUsuario = numerosApenas.Substring(0, 4) + "." + numerosApenas.Substring(4);
        }
        else
        {
            respostaUsuario = numerosApenas;
        }
    }

}