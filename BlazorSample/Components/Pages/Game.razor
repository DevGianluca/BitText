@page "/game"
@using System.Reflection
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@implements IDisposable
@implements IAsyncDisposable


<PageTitle>Jogo | BitText</PageTitle>

<section class="game-page">
    <div class="game-heading">
        <p class="eyebrow"><span class="status-dot"></span> ÁREA DE JOGO</p>
        <h1>Prepare-se para <span>jogar</span></h1>
        <p>Converta cada letra para binário e envie sua resposta.</p>
    </div>

    <div class="game-screen" role="region" aria-label="Tela do jogo">
        <div class="screen-toolbar">
            <span>BITTEXT // GAME.EXE</span>
            @if (opcaoSelecionado == 1 || opcaoSelecionado == 2)
            {
                <button class="game-action game-action--exit" @onclick="() => selecionar(0)">EXIT</button>
            }
            else if (opcaoSelecionado == 3)
            {
                <button class="game-action game-action--save-exit" @onclick="() => selecionar(0)">Salvar e Sair</button>
            }
            else
            {
                <span class="screen-indicator"><span class="status-dot"></span> AGUARDANDO</span>
            }
        </div>
        <div class="screen-placeholder">
            @if (opcaoSelecionado == 0)
            // tela onde se ira escolher entre jogar tutorial e configs
            {
                <div class="flex flex-col items-center gap-4">

                    <div class="flex gap-4">
                        <button type="button"
                                class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                                @onclick="() => selecionar(1)">
                            Tutorial
                        </button>
                        <button type="button"
                                class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                                @onclick="() => selecionar(2)">
                            Jogar
                        </button>
                    </div>
                    <button type="button"
                            class="rounded border border-[#00ff41] bg-transparent px-6 py-3 font-bold text-[#00ff41] transition hover:shadow-[0_0_16px_rgba(0,255,65,0.45)]"
                            @onclick="() => selecionar(3)">
                        Configurar
                    </button>
                </div>
            }
            //TUTORIAL
            else if (opcaoSelecionado == 1 || opcaoSelecionado == 2)
            {
                //tela de jogo ou tutorial sendo tutorial 1 e jogo 2

                <div class="game-controls">
                    <div class="game-hud @(opcaoSelecionado == 1 ? "game-hud--tutorial" : "")">
                        @if (opcaoSelecionado == 2)
                        {
                            <div class="game-hud__item">
                                <span class="game-hud__label">Tempo</span>
                                @if (tempoIlimitado)
                                {
                                    <span class="game-hud__value">∞</span>
                                }
                                else
                                {
                                    <span class="game-hud__value">@tempo</span>
                                }
                            </div>

                        }
                        <div class="game-hud__item">
                            <span class="game-hud__label">Pontos</span>
                            <span class="game-hud__value">@pontos</span>
                        </div>
                        @if (opcaoSelecionado == 2)
                        {
                            <div class="game-hud__item">
                                <span class="game-hud__label">Vidas</span>
                                <span class="game-hud__value">@vidas</span>
                            </div>
                        }
                    </div>
                    <div class="game-letter">@letra</div>
                    @if (mostrarErro)
                    {
                        <div class="game-feedback" role="alert" aria-live="assertive">
                            Incorreto! O binário da letra <strong>@letraAnterior</strong> era
                            <strong class="game-feedback__binary">@letraBinariaAnterior</strong>
                        </div>
                    }
                    <input class="game-answer-input" type="text" id="resposta" name="resposta_jogo" @bind="respostaUsuario"
                           @onkeyup="VerificarEnter"
                           oninput="let v = this.value.replace(/[^01]/g, ''); this.value = v.length > 4 ? v.slice(0, 4) + '.' + v.slice(4, 8) : v;"
                           maxlength="9" autocomplete="off" spellcheck="false" />

                    <div class="game-input-buttons">
                        <button class="game-button game-button--digit" type="button" @onclick="addZero">0</button>
                        <button class="game-button game-button--digit" type="button" @onclick="addUm">1</button>
                        <button class="game-button game-button--remove" type="button" @onclick="remover">Remover</button>
                    </div>

                    <button class="game-submit" type="button" @onclick="EnviarResposta">Enviar</button>
                </div>

            }
            else if (opcaoSelecionado == 3)
            {
                <div class="flex flex-col gap-6 w-full max-w-xs mx-auto mt-8 font-mono text-[#00ff41]">

                    <!-- Título da aba -->
                    <h2 class="text-2xl text-center font-bold text-[#00ff41] drop-shadow-[0_0_8px_rgba(0,255,65,0.7)] mb-4">
                        CONFIGURAÇÕES
                    </h2>
                    <div class="time-setting">
                        <label for="tempo" class="time-setting__label">Tempo (em segundos)</label>
                        <input id="tempo" name="tempo" type="number" min="10" max="300" @bind="tempoConfigurado"
                               disabled="@tempoIlimitado" class="time-setting__input" />
                        <label class="unlimited-toggle">
                            <input type="checkbox" @bind="tempoIlimitado" class="unlimited-toggle__input" />
                            <span class="unlimited-toggle__box" aria-hidden="true"></span>
                            <span class="unlimited-toggle__text">Ilimitado <span aria-hidden="true">∞</span></span>
                        </label>
                    </div>

                    <!-- Campo VIDAS -->
                    <div class="flex flex-col">
                        <label for="vidas" class="mb-2 text-sm uppercase tracking-widest text-[#00ff41]">Vidas
                            Iniciais</label>
                            <input id="vidas" name="vidas" type="number" min="1" max="10" @bind="vidasConfiguradas"
                                   class="bg-black border border-[#00ff41] text-[#00ff41] text-xl px-4 py-2 outline-none focus:border-[#00ff41] focus:shadow-[0_0_12px_rgba(0,255,65,0.7)] transition-all" />
                        </div>
                    </div>

                }

            </div>
            @if (mostrarGameOver)
            {
                <div class="game-over-overlay" role="dialog" aria-modal="true" aria-labelledby="game-over-title">
                    <div class="game-over-card">
                        <p class="game-over-card__eyebrow">FIM DE JOGO</p>
                        <h2 id="game-over-title">Você Perdeu</h2>
                        <p class="game-over-card__detail">A última letra foi <strong>@letraAnterior</strong>.</p>
                        <p class="game-over-card__detail">
                            O binário correto era
                            <strong class="game-over-card__binary">@letraBinariaAnterior</strong>
                        </p>
                        <p class="game-over-card__score">
                            PONTUAÇÃO FINAL
                            <strong>@pontos</strong>
                        </p>
                        <button class="game-over-button" type="button" @onclick="() => selecionar(2)">
                            Jogar Novamente
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>

@code {

    private char letra;
    private string letraBinaria = "";
    private int opcaoSelecionado = 0;
    private int pontos = 0;
    private bool tempoIlimitado = false;
    private int tempo = 60; // segundos 60 = 1min
    private int tempoConfigurado = 60;
    private int vidas = 3;
    private int vidasConfiguradas = 3;
    private string respostaUsuario = "";
    private bool mostrarGameOver = false;
    private bool mostrarErro = false;
    private char? letraAnterior;
    private string? letraBinariaAnterior;

    private Guid? ticketAtual;
    private CancellationTokenSource? cronometroCancellation;
    private Task? cronometroTask;
    private bool disposed;




    private async Task VerificarEnter(KeyboardEventArgs e)
    {
        // Se a tecla pressionada for o "Enter", dispara a lógica de envio
        if (e.Key == "Enter")
        {
            await EnviarResposta();
        }
    }


    private async Task IniciarJogo()
    {
        await PararCronometroAsync();
        LimparEstadoDaPartida();
        vidas = vidasConfiguradas;
        tempo = tempoConfigurado;

        if (opcaoSelecionado == 1)
        {
            letra = 'A';
        }
        else
        {
            ConfigJogadores config = new ConfigJogadores(tempoIlimitado ? null : tempoConfigurado)
            {
                Vidas = vidasConfiguradas
            };
            var resposta = await Http.PostAsJsonAsync("http://api:8080/Game/iniciar", config);
            var dados = await resposta.Content.ReadFromJsonAsync<RetornoNovaLetra>();
            if (dados != null)
            {
                ticketAtual = dados.Ticket;
                letra = dados.LetraSorteada;

                if (!tempoIlimitado)
                {
                    if (tempo <= 0)
                    {
                        EncerrarPartidaPorTempo();
                    }
                    else
                    {
                        IniciarCronometro();
                    }
                }
            }
        }
    }

    private void LimparEstadoDaPartida()
    {
        cronometroCancellation?.Cancel();
        ticketAtual = null;
        respostaUsuario = "";
        pontos = 0;
        mostrarErro = false;
        mostrarGameOver = false;
        letraAnterior = null;
        letraBinariaAnterior = null;
    }

    private void IniciarCronometro()
    {
        var cancellation = new CancellationTokenSource();
        cronometroCancellation = cancellation;
        cronometroTask = ExecutarCronometroAsync(cancellation);
    }

    private void EncerrarPartidaPorTempo()
    {
        letraAnterior = letra;
        letraBinaria = Convert.ToString(letra, 2).PadLeft(8, '0');
        letraBinariaAnterior = letraBinaria.Insert(4, ".");
        mostrarGameOver = true;
        ticketAtual = null;
    }

    private async Task ExecutarCronometroAsync(CancellationTokenSource cancellation)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellation.Token))
            {
                if (tempo > 0)
                {
                    tempo--;
                }

                if (tempo == 0)
                {
                    EncerrarPartidaPorTempo();
                    cancellation.Cancel();
                }

                await InvokeAsync(StateHasChanged);

                if (tempo == 0)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(cronometroCancellation, cancellation))
            {
                cronometroCancellation = null;
                cronometroTask = null;
            }

            cancellation.Dispose();
        }
    }

    private async Task PararCronometroAsync()
    {
        var cancellation = cronometroCancellation;
        var task = cronometroTask;
        if (cancellation is null)
        {
            return;
        }

        cronometroCancellation = null;
        cancellation.Cancel();

        if (task is not null)
        {
            await task;
        }
    }

    private async Task EnviarResposta()
    {
        mostrarErro = false;
        letraAnterior = letra;
        string respostaLimpa = respostaUsuario.Trim().Replace(".", "");
        if (opcaoSelecionado == 1)
        {
            letraBinaria = Convert.ToString(letra, 2).PadLeft(8, '0');
            letraBinariaAnterior = letraBinaria.Insert(4, ".");

            if (respostaLimpa == letraBinaria)
            {
                pontos++;
                letra++;
                mostrarErro = false;
            }
            else
            {
                mostrarErro = true;
            }

        }
        else
        {
            if (ticketAtual is not Guid ticket)
            {
                return;
            }

            RespostaJogador jogador = new RespostaJogador();
            jogador.InputJogador = respostaLimpa;
            jogador.Ticket = ticket;

            var resposta = await Http.PostAsJsonAsync("http://api:8080/Game/validar", jogador);
            var dados = await resposta.Content.ReadFromJsonAsync<RespostaCorreta>();
            if (dados != null)
            {

                if (!dados.Acertou)
                {
                    string? binarioCorreto = dados.LetraBinarioCorreta;
                    letraBinariaAnterior = binarioCorreto is { Length: >= 8 }
                        ? binarioCorreto.Insert(4, ".")
                        : binarioCorreto;
                    if (dados.GameOver)
                    {
                        // aparecer tela de gameOVer com a letra que estava nessa rodada + a resposta correta em binario dessa letra
                        mostrarGameOver = true;
                        ticketAtual = null;
                        await PararCronometroAsync();
                    }

                    mostrarErro = true;
                }
                else
                {

                }
                vidas = dados.VidasRestantes;
                pontos = dados.PontuacaoAtual;
                if (dados.ProximaLetra != null) letra = dados.ProximaLetra.Value;

            }
        }


        respostaUsuario = "";
        await InvokeAsync(StateHasChanged);
    }


    //faz com que a saiba qual opção pe escolhida
    private async Task selecionar(int opcao)
    {
        if (opcao is not 1 and not 2)
        {
            await PararCronometroAsync();
            ticketAtual = null;
        }

        letraAnterior = null;
        letraBinariaAnterior = null;
        mostrarGameOver = false;
        mostrarErro = false;
        respostaUsuario = "";
        opcaoSelecionado = opcao;
        scrollToGameControls = opcao is 1 or 2;

        if (opcao == 1 || opcao == 2)
        {
            await IniciarJogo();
            if (vidas <= 0)
            {
                vidas = 3;
            }
        }


    }

    // remove as letras pelo botão
    private void remover()
    {
        if (string.IsNullOrEmpty(respostaUsuario)) return;
        string numerosApenas = respostaUsuario.Replace(".", "");

        numerosApenas = numerosApenas.Remove(numerosApenas.Length - 1, 1);
        if (numerosApenas.Length > 4)
        {
            respostaUsuario = numerosApenas.Substring(0, 4) + "." + numerosApenas.Substring(4);
        }
        else
        {
            respostaUsuario = numerosApenas;
        }
    }

    private void addZero() => AdicionarNumero('0'); //adiciona 0 com o botão
    private void addUm() => AdicionarNumero('1'); // adiciona 1 Mesma coisa

    private void AdicionarNumero(char numero)
    {
        string numerosApenas = respostaUsuario.Replace(".", "");
        if (numerosApenas.Length >= 8) return;
        numerosApenas += numero;
        if (numerosApenas.Length > 4)
        {
            respostaUsuario = numerosApenas.Substring(0, 4) + "." + numerosApenas.Substring(4);
        }
        else
        {
            respostaUsuario = numerosApenas;
        }
    }

    // aqui faz o site descer um pouco e deixar a tela em uma posição melhor
    private IJSObjectReference? gameModule;
    private bool scrollToGameControls;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToGameControls)
        {
            return;
        }

        scrollToGameControls = false;
        gameModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/game.js");
        await gameModule.InvokeVoidAsync("scrollToGameControls");
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (gameModule is not null)
        {
            await gameModule.DisposeAsync();
        }
    }

    public void Dispose()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;
        cronometroCancellation?.Cancel();
    }

}