@page "/Error"
@using System.Diagnostics

<PageTitle>ERRO CRÍTICO | BitText</PageTitle>

<section class="w-full max-w-3xl border border-[#00FF41] bg-black p-6 font-mono text-[#00FF41] shadow-[0_0_32px_rgba(0,255,65,0.35)] sm:p-10"
         aria-labelledby="critical-error-title">
    <p class="mb-6 text-sm uppercase tracking-[0.2em] text-[#00FF41]">BITTEXT // PROTOCOLO DE EMERGÊNCIA</p>
    <p class="mb-2 text-sm text-[#00FF41]">&gt; system.connection --status</p>
    <h1 id="critical-error-title" class="mb-6 text-3xl font-bold tracking-widest text-[#00FF41] drop-shadow-[0_0_16px_rgba(0,255,65,0.9)] sm:text-5xl">
        ERRO CRÍTICO
    </h1>
    <p class="text-base leading-relaxed text-[#00FF41] sm:text-lg">
        FALHA DE SISTEMA: Intervenção de Agente detectada. Conexão cortada para proteção.<span class="animate-pulse" aria-hidden="true">_</span>
    </p>
    @if (ShowRequestId)
    {
        <p class="mt-4 break-all text-xs text-[#00FF41]/70">TRACE_ID: @RequestId</p>
    }
    <a href="/"
       class="mt-10 inline-flex border border-[#00FF41] bg-[#00FF41] px-5 py-3 font-mono text-sm font-bold tracking-widest text-black no-underline transition hover:bg-black hover:text-[#00FF41] hover:shadow-[0_0_18px_rgba(0,255,65,0.7)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#00FF41]">
        ACORDAR (Voltar ao Início)
    </a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
